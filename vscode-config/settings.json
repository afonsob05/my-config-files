{
    "security.workspace.trust.untrustedFiles": "open",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 10,
    "editor.autoClosingOvertype": "always",
    "editor.rulers": [
        {
        "column": 80,    
        "color": "#3b4556",
        "opacity": 20
        },
        {
        "column": 100,
        "color": "#3b4556" 
    },
    ],
    "editor.fontLigatures": true,
    "cmake.configureOnOpen": true,
    "git.autofetch": true,
    "symbols.hidesExplorerArrows": false,
    "editor.fontSize": 14,
    "editor.renderLineHighlight": "gutter",

    "workbench.colorTheme": "Default Dark+",
    "workbench.editor.labelFormat": "short",
    "workbench.editor.tabSizing": "fixed",
    "workbench.statusBar.visible": false,
    "workbench.startupEditor": "none",
    "workbench.editor.showTabs": "multiple",
    "explorer.compactFolders": false,
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.tree.indent": 8,
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.horizontal": "hidden",
    "workbench.layoutControl.enabled": false,
    "workbench.tips.enabled": false,
    "update.mode": "manual",
    "settingsSync.ignoredExtensions": [
        "ttoowa.in-your-face-incredible"
    ],
    
    "git.enableSmartCommit": false,
    "git.confirmSync": false,
    "transparent-win.transparency": 0.2,
    "glassit.force_sway": true,
    "github.copilot.editor.enableAutoCompletions": true,
    "workbench.colorCustomizations": {
        "terminal.background": "#00000000",
        "editorPane.background": "#1e1e1e00",
        "editorGroupHeader.tabsBackground": "#1e1e1e00",
        "editorGroupHeader.noTabsBackground": "#1e1e1e00",
        "breadcrumb.background": "#1e1e1e00",
        "editorGutter.background": "#1e1e1e00",
        "panel.background": "#1e1e1e00",
        "tab.activeBackground": "#1e1e1e00",
        "tab.unfocusedActiveBackground": "#1e1e1e00",
        "sideBar.background": "#1e1e1eff",
        "sideBarTitle.background": "#1e1e1eff",
        "activityBar.background": "#1e1e1eff",
        "editor.background": "#1e1e1eff",
        "tab.inactiveBackground": "#1e1e1eff",
        "tab.unfocusedInactiveBackground": "#1e1e1eff",
        "editorStickyScroll.background": "#1e1e1eff",
        "editorStickyScrollGutter.background": "#1e1e1eff",
        "sideBarStickyScroll.background": "#1e1e1eff",
        "panelStickyScroll.background": "#1e1e1eff",
        "terminalStickyScroll.background": "#1e1e1eff",
        "minimap.background": "#1e1e1eff",
        "inlineChat.background": "#1e1e1ee6",
        "editorWidget.background": "#1e1e1ee6",
        "editorHoverWidget.background": "#1e1e1ee6",
        "editorSuggestWidget.background": "#1e1e1ee6",
        "notifications.background": "#1e1e1ee6",
        "notificationCenterHeader.background": "#1e1e1ee6",
        "menu.background": "#1e1e1ee6",
        "quickInput.background": "#1e1e1ee6",
        "editor.lineHighlightBorder": "#00000000"
    },
    "workbench.settings.applyToAllProfiles": [],
    "vscode_vibrancy.opacity": 1,
    "github.copilot.nextEditSuggestions.enabled": true,
    "window.titleBarStyle": "custom",
    "window.title": "${activeEditorShort}",
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://biomejs.dev": true
    },
    "chat.viewSessions.orientation": "stacked",
    "java.project.importOnFirstTimeStartup": "disabled",
    "java.format.comments.enabled": false,
    "java.format.onType.enabled": false,
    "java.format.enabled": false,

    "java.sources.organizeImports.starThreshold": 2,
    "java.sources.organizeImports.staticStarThreshold": 2,
    "liveServer.settings.donotShowInfoMsg": true,
    "editor.minimap.renderCharacters": false,
    "diffEditor.codeLens": true,
    "git.ignoreRebaseWarning": true,
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Tokyo Night",
    "diffEditor.ignoreTrimWhitespace": false,
    "workbench.iconTheme": "symbols",
    "material-icon-theme.hidesExplorerArrows": true,

    "workbench.activityBar.location": "top",
    "makefile.configureOnOpen": true,
    "files.associations": {
        "*.cpp": "cpp",
        "*.als": "alloy",
        "*.java": "java",
        "*.py": "python",
        "*.pdf": "pdf",
        "*.md": "markdown",
        "*.json": "jsonc",
        "*.js": "javascript",
        "*.ts": "typescript",
        "*.html": "html",
        "*.css": "css",
        "*.dfy": "dafny",
        "*.c": "c",
    },
    "workbench.preferredDarkColorTheme": "Tokyo Night",
    "workbench.browser.showInTitleBar": false,
    "window.menuBarVisibility": "compact",
    "workbench.navigationControl.enabled": false,
    "window.commandCenter": false,
    "window.zoomLevel": 1,
    "js/ts.experimental.useTsgo": true,
    "editor.minimap.enabled": true,
    "editor.minimap.showSlider": "always",
    "editor.minimap.size": "fit",
    "breadcrumbs.enabled": false,
    "biome.suggestInstallingGlobally": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "explorer.decorations.badges": false,
    "git.decorations.enabled": false,
    "githubPullRequests.pullBranch": "never",
    "editor.unicodeHighlight.invisibleCharacters": true,
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "files.exclude": {
        "**/.git": false
    },
    "git.openRepositoryInParentFolders": "never",
    "jdk.telemetry.enabled": false,
    "workbench.sideBar.location": "right",
    "chat.editing.confirmEditRequestRemoval": false,
    "explorer.confirmPasteNative": false,
    "terminal.integrated.gpuAcceleration": "off",
}